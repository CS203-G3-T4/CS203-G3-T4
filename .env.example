# Both terminals: set -a; . ./.env; set +a
# Spring and Python do not load .env automatically. Keep this file local when copied.
DB_URL=jdbc:postgresql://localhost:55432/energy_market
DB_USER=energy_market
DB_PASSWORD=energy_market
# Optional: set your authorized collector data directory for offline snapshot/training only.
COLLECTOR_DATA_DIR=
# Relative to the Git root; use an absolute persistent path for scheduled operation.
WATTLY_ML_HOME=.local/wattly-ml
FORECAST_PYTHON_URL=http://127.0.0.1:8001
FORECAST_MODE=LIVE
FORECAST_PERIOD_MAPPING_EVIDENCE=
# Optional one-time idempotent import on Spring startup; unset after importing.
FORECAST_IMPORT_FILE=
# Optional forecasting-only local/demo fallback. Shared auth should own production access.
WATTLY_FORECAST_LOCAL_ADMIN_ENABLED=false
# Requires explicit opt-in above AND both private credentials.
WATTLY_ADMIN_USER=
WATTLY_ADMIN_PASSWORD=
# Training attempts/ranking/savings use this protected Spring endpoint.
WATTLY_RUN_API_URL=http://127.0.0.1:8080
# CPU limits apply to offline training and inference.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
