# Match the existing model's exact Python/dependency contract. A different model
# runtime requires a reviewed image build and its regression tests, not a bypass.
ARG PYTHON_IMAGE=python:3.12.3-slim-bookworm@sha256:afc139a0a640942491ec481ad8dda10f2c5b753f5c969393b12480155fe15a63
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 \
    WATTLY_WEEKLY_HOME=/var/lib/wattly-weekly \
    WATTLY_WEEKLY_CHAMPION=/inputs/models/champion \
    WATTLY_WEEKLY_SOURCE=postgres
WORKDIR /opt/wattly-ml
RUN apt-get update \
    && apt-get install -y --no-install-recommends libstdc++6 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.lock requirements-server.lock pyproject.toml ./
RUN python -m pip install --no-cache-dir -r requirements-server.lock
COPY src ./src
RUN python -m pip install --no-cache-dir --no-deps --no-build-isolation . \
    && python -m pip check \
    && mkdir -p /var/lib/wattly-weekly \
    && chown 10001:10001 /var/lib/wattly-weekly
USER 10001:10001
ENTRYPOINT ["python", "-m", "wattly_ml.portable_weekly"]
CMD ["check"]
