# Inject privately on the deployment host/provider. Do not commit populated files.
# Never reuse the public demo passwords on a publicly accessible deployment.
WATTLY_RUN_API_URL=https://your-wattly-service.example
WATTLY_RUN_AUTH_MODE=session
WATTLY_ADMIN_USER=
WATTLY_ADMIN_PASSWORD=
# Alternatively use WATTLY_ADMIN_USER_FILE / WATTLY_ADMIN_PASSWORD_FILE.
WATTLY_TRAINING_DATABASE_URL=
# Use a SELECT-only PostgreSQL account for market_price_revision.
# Alternatively use WATTLY_TRAINING_DATABASE_URL_FILE.
WATTLY_WEEKLY_HOME=/var/lib/wattly-weekly
WATTLY_WEEKLY_CHAMPION=/inputs/models/champion
WATTLY_WEEKLY_CHAMPION_SHA256=
WATTLY_WEEKLY_SOURCE=postgres
# sqlite alternative: set source=sqlite and WATTLY_WEEKLY_COLLECTOR=/inputs/collector.sqlite3
# Confirm only after provisioning retained storage and a single coordinated worker.
WATTLY_WEEKLY_STORAGE_READY=false
WATTLY_WEEKLY_SINGLE_WORKER=false
# Off by default. One caller/one durable runtime for each app deployment.
WATTLY_WEEKLY_ENABLED=false
# Preserve the existing reserved evaluation before first candidate work.
WATTLY_WEEKLY_NOT_BEFORE=2026-11-08T20:00:00+08:00
