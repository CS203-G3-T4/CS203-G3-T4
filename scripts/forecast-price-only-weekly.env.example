# Copy outside Git, owned by the worker user, chmod 600. Do not enable yet.
WATTLY_PYTHON=/absolute/path/to/dedicated/python
WATTLY_RUN_API_URL=http://127.0.0.1:8080
WATTLY_RUN_AUTH_MODE=session
WATTLY_ADMIN_USER=
WATTLY_ADMIN_PASSWORD=
# Do not set WATTLY_ML_HOME to the weekly output directory.
# The JSON configuration keeps the training runtime separate from serving.
