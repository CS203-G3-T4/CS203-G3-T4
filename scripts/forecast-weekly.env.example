# Copy to a private file outside source control; chmod 600 before installing.
WATTLY_PYTHON=/absolute/path/to/dedicated/python
WATTLY_ML_HOME=/absolute/path/to/training-and-serving-runtime
COLLECTOR_DATA_DIR=/home/bryan/cs203/data
WATTLY_HISTORY_SNAPSHOTS=/absolute/path/to/official-immutable-snapshots
WATTLY_RUN_API_URL=http://127.0.0.1:8080
# For a local/demo Spring app only: explicitly enable its forecasting fallback.
WATTLY_FORECAST_LOCAL_ADMIN_ENABLED=false
WATTLY_ADMIN_USER=choose-a-local-admin-name
WATTLY_ADMIN_PASSWORD=replace-with-a-private-password
WATTLY_TRUTH_POLICY=PROVISIONAL
# FINAL plus retrospective=true is only for explicitly retrospective final-price studies.
WATTLY_TRAIN_RETROSPECTIVE=false
WATTLY_VALIDATION_DAYS=28
WATTLY_PROTECTED_START=2026-07-29T00:00:00+08:00
WATTLY_PROTECTED_END=2026-09-29T00:00:00+08:00
# Includes the frozen July/August study and designated September28 demo day.
WATTLY_TIMER_CALENDAR='Sun *-*-* 03:00:00 Asia/Singapore'
